# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN - FACTURADOR SUNAT
# ==========================================

# Entorno de ejecución (production | development)
NODE_ENV=production

# Puerto HTTP del servidor Express
PORT=3000

# URL pública del facturador (dominio con HTTPS en producción)
APP_URL=https://facturador.tudominio.com

# Base de datos (SQLite por defecto, o PostgreSQL para clusters grandes)
DATABASE_URL="file:./prod.db"
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/facturador_sunat?schema=public"

# Clave secreta para generación y firma de tokens JWT (SuperAdmin & Tenants)
# IMPORTANTE: Cambia esta cadena por una clave aleatoria larga y segura
JWT_SECRET=generar_una_clave_jwt_aleatoria_muy_segura_para_produccion_2026

# Directorio local de almacenamiento de comprobantes (por defecto: storage/comprobantes)
STORAGE_DIR=storage/comprobantes

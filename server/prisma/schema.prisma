datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  name            String
  role            String         @default("USER") // "USER" | "SUPERADMIN"
  status          String         @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  
  // Plan & Quota Tracking
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id])
  planExpiresAt   DateTime?
  docsIssuedCount Int            @default(0)

  // Multi-user & Roles per Tenant
  parentId        String?
  parent          User?          @relation("TenantSubUsers", fields: [parentId], references: [id], onDelete: Cascade)
  subUsers        User[]         @relation("TenantSubUsers")
  tenantRole      String?        @default("ADMIN") // "ADMIN", "SUBADMIN", "CONTADOR", "OPERADOR"

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  companies       Company[]
  apiKeys         ApiKey[]
  paymentOrders   PaymentOrder[]
}

model Company {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ruc                String    // RUC (11 dígitos)
  razonSocial        String
  nombreComercial    String?
  direccion          String
  contacto           String?   // email - teléfono (ej: contacto@esg.la - 997592981)
  piePagina          String?   // Pie de página para impresión (saludos, cuentas, etc)
  logoBase64         String?   // Logo personalizado de la empresa
  mostrarLogoTicket  Boolean   @default(true) // Mostrar en formato Ticket
  
  // Cuentas Bancarias (JSON array: [{ cuenta, cci, banco, moneda }])
  bankAccountsJson   String?   @default("[]")
  
  // Preferencias para el Aplicativo (JSON: predeterminados + opciones extra)
  preferencesJson    String?   @default("{}")
  
  // Credenciales SUNAT
  usuarioSol         String    @default("MODDATOS")
  claveSol           String    @default("moddatos")
  pfxCert            Bytes?    // Certificado Digital (.pfx)
  pfxPassword        String?
  isProduction       Boolean   @default(false)
  
  // Bot de Telegram específico de esta empresa
  telegramToken      String?
  
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  invoices           Invoice[]
  buzonNotifications BuzonSolNotification[]
  sunafilAlerts      SunafilAlert[]
}

model Invoice {
  id                 String    @id // Formato: F001-00000001
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  tipoDoc            String    // "01"=Factura, "03"=Boleta, "07"=Nota Crédito
  serie              String?
  correlativo        String?
  clienteTipoDoc     String    // "6"=RUC, "1"=DNI
  clienteDoc         String
  clienteNombre      String
  clienteDireccion   String?
  
  fechaEmision       String?
  fechaVencimiento   String?
  tipoOperacion      String?   @default("0101")
  moneda             String?   @default("PEN")
  formaPago          String?   @default("Contado")
  observaciones      String?
  
  montoGravado       Float
  montoIgv           Float
  montoTotal         Float
  itemsJson          String    // JSON con array de ítems
  
  xmlSigned          String?   // Texto XML firmado
  xmlZip             Bytes?    // ZIP del XML
  cdrZip             Bytes?    // Constancia de Recepción de SUNAT
  status             String    // "ACEPTADO", "RECHAZADO", "ANULADO", "ERROR"
  sunatResponseCode  String?
  sunatMessage       String?
  sunatObservations  String?
  createdAt          DateTime  @default(now())
}

model PlatformConfig {
  id                   Int       @id @default(1)
  platformName         String    @default("APISUNAT PRO")
  platformSubtitle     String?   @default("Plataforma SaaS Multitenant de Facturación Electrónica SUNAT")
  logoUrl              String?   // Logo de la plataforma (marca blanca)
  primaryColor         String    @default("#2563eb")
  allowRegistration    Boolean   @default(true)
  telegramBotEnabled   Boolean   @default(true)
  supportEmail         String?   @default("soporte@apisunat.com")
  supportPhone         String?   @default("+51 999 888 777")
  
  // Configuración de Storage / File Server / S3
  storageProvider      String    @default("LOCAL") // "LOCAL" | "S3" | "SFTP" | "HYBRID"
  localStoragePath     String    @default("storage/comprobantes")
  
  // Amazon S3 / Compatible (Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces)
  s3Endpoint           String?   // Ej: https://<account_id>.r2.cloudflarestorage.com o http://127.0.0.1:9000
  s3Region             String?   @default("us-east-1")
  s3Bucket             String?
  s3AccessKey          String?
  s3SecretKey          String?
  s3ForcePathStyle     Boolean   @default(false) // true para MinIO
  s3PublicUrl          String?   // Opcional: URL pública CDN
  
  // File Server Remoto / SFTP
  sftpHost             String?
  sftpPort             Int?      @default(22)
  sftpUser             String?
  sftpPassword         String?
  sftpRemotePath       String?   @default("/var/storage/comprobantes")

  // Pasarelas de Pago (Configurables por SuperAdmin)
  // 1. Izipay
  izipayActive         Boolean   @default(false)
  izipayPublicKey      String?
  izipayClientAnswer   String?
  izipayShaKey         String?
  izipaySandbox        Boolean   @default(true)

  // 2. Mercado Pago
  mercadopagoActive    Boolean   @default(false)
  mercadopagoPublicKey String?
  mercadopagoAccessToken String?
  mercadopagoSandbox   Boolean   @default(true)

  // 3. PayPal
  paypalActive         Boolean   @default(false)
  paypalClientId       String?
  paypalSecret         String?
  paypalMode           String?   @default("sandbox") // "sandbox" | "live"

  // 4. Culqi
  culqiActive          Boolean   @default(false)
  culqiPublicKey       String?
  culqiSecretKey       String?

  // 5. Transferencia Bancaria Manual
  bankTransferActive   Boolean   @default(true)
  bankTransferInfo     String?   @default("BCP Cta Cte Soles: 191-9876543-0-12 (CCI: 002-191-009876543012-34)\nBBVA Cta Cte Soles: 0011-0123-0100012345 (CCI: 011-123-000100012345-67)\nYape / Plin: 999 888 777 a nombre de APISUNAT PRO S.A.C.")

  updatedAt            DateTime  @updatedAt
}

model Plan {
  id             String         @id @default(uuid())
  name           String
  code           String         @unique // "FREE", "STARTER", "EMPRENDEDOR", "CORPORATIVO"
  description    String?
  price          Float          @default(0)
  currency       String         @default("PEN")
  billingPeriod  String         @default("MONTHLY") // "MONTHLY" | "ANNUAL"
  docLimit       Int            @default(30) // -1 para ilimitado
  userLimit      Int            @default(1)
  durationDays   Int            @default(30)
  featuresJson   String         @default("[]")
  isPopular      Boolean        @default(false)
  isActive       Boolean        @default(true)
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users          User[]
  paymentOrders  PaymentOrder[]
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    // Ej: "WHMCS Producción", "ERP Principal"
  key        String    @unique // Formato: "sk_live_..."
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model PaymentOrder {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id])
  gateway     String    // "IZIPAY" | "MERCADOPAGO" | "PAYPAL" | "CULQI" | "MANUAL"
  amount      Float
  currency    String    @default("PEN")
  status      String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  gatewayRef  String?   // External transaction / preference ID
  metaJson    String?   @default("{}")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Config {
  id              Int      @id @default(1)
  ruc             String
  razonSocial     String
  nombreComercial String?
  direccion       String
  usuarioSol      String
  claveSol        String
  pfxCert         Bytes?
  pfxPassword     String?
  telegramToken   String?
  isProduction    Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model BuzonSolNotification {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  numNotificacion    String    // Ej: "NOT-2026-003891"
  tipoNotificacion   String    // "RESOLUCION", "ESQUELA", "CARTA_INDUCTIVA", "COBRANZA_COACTIVA", "AVISO_INFORMATIVO"
  asunto             String
  contenido          String?
  fechaDeposito      String    // "YYYY-MM-DD"
  fechaNotificacion  String?   // "YYYY-MM-DD"
  fechaVencimiento   String?   // "YYYY-MM-DD"
  leido              Boolean   @default(false)
  etiqueta           String?   // "URGENTE", "PLAZO_VENCE", "INFORMATIVO"
  adjuntoUrl         String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SunafilAlert {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  numExpediente      String    // Ej: "EXP-2026-SUNAFIL-884"
  tipoDocumento      String    // "REQUERIMIENTO_INFORMACION", "CARTA_INDUCTIVA", "NOTIFICACION_INSPECCION", "ACTA_INFRACCION", "ALERTA_PREVENTIVA"
  materia            String    // "Seguridad y Salud en el Trabajo", "Planilla y Contratos", "Jornada Laboral", "Comité SST"
  asunto             String
  descripcion        String?
  fechaDeposito      String    // "YYYY-MM-DD"
  fechaVencimiento   String?   // "YYYY-MM-DD" (Plazo de descargos)
  leido              Boolean   @default(false)
  estado             String    @default("PENDIENTE") // "PENDIENTE", "ATENDIDO", "VENCIDO"
  prioridad          String    @default("MEDIA") // "ALTA", "MEDIA", "BAJA"
  adjuntoUrl         String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
